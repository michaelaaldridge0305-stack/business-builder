# Copy these names into your hosting provider's secret/environment settings.
# Never put real values in this file.
GEMINI_API_KEY=replace-in-host-secret-settings
ACTION_API_KEY=generate-a-separate-long-random-value
# Optional outside Render; Render supplies RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=https://video-analyser.example.com
WATCH_VIDEO_WORKERS=2
MAX_UPLOAD_BYTES=536870912
